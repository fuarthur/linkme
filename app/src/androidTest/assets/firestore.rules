rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function bounded(maximum) {
      return request.query.limit != null && request.query.limit <= maximum;
    }

    function validUid(uid) {
      return uid is string && uid.size() > 0 && uid.size() <= 128
        && uid.matches('^[^/]+$');
    }

    function validMembers(members) {
      return members is list && members.size() == 2
        && validUid(members[0]) && validUid(members[1])
        && members[0] != members[1];
    }

    function conversationKey(firstUid, secondUid) {
      let first = firstUid < secondUid ? firstUid : secondUid;
      let second = firstUid < secondUid ? secondUid : firstUid;
      let key = string(first.size()) + ':' + first + string(second.size()) + ':' + second;
      return hashing.sha256(key).toHexString().lower();
    }

    function validDocumentId(id) {
      return id is string && id.size() > 0 && id.size() <= 512
        && id.matches('^[^/]+$');
    }

    function freshMessageForSummary(data, conversationId) {
      let messagePath = /databases/$(database)/documents/Messages/$(data.lastMessageId);
      let message = getAfter(messagePath).data;
      return !exists(messagePath)
        && message.conversationId == conversationId
        && validMembers(message.members) && message.members.toSet() == data.members.toSet()
        && message.senderId == data.lastSenderId
        && message.content == data.lastMessage
        && message.timestamp == request.time;
    }

    function validText(text) {
      // A multiline message must contain at least one non-whitespace character.
      return text is string && text.size() > 0 && text.size() <= 2000
        && text.matches('[\\s\\S]*[^\\s][\\s\\S]*');
    }

    function notBlocked(first, second) {
      return !exists(/databases/$(database)/documents/Users/$(first)/Blocked/$(second))
        && !exists(/databases/$(database)/documents/Users/$(second)/Blocked/$(first));
    }

    function validInterest(label) {
      // Android normalizes aliases/spacing. A label needs a visible character
      // and cannot contain C0/C1 controls; size() counts UTF-16 code units.
      return label is string && label.size() <= 40
        && label.matches('[^\\p{Cc}]*[^\\s\\p{Z}\\p{Cf}\\p{Cc}][^\\p{Cc}]*');
    }

    function validInterests(interests) {
      let count = interests.size();
      // Rules have no loops. Keep these checks flat to fit the expression budget.
      return interests is list && count >= 1 && count <= 16
        && interests.toSet().size() == count
        && validInterest(interests[0])
        && (count <= 1 || validInterest(interests[1]))
        && (count <= 2 || validInterest(interests[2]))
        && (count <= 3 || validInterest(interests[3]))
        && (count <= 4 || validInterest(interests[4]))
        && (count <= 5 || validInterest(interests[5]))
        && (count <= 6 || validInterest(interests[6]))
        && (count <= 7 || validInterest(interests[7]))
        && (count <= 8 || validInterest(interests[8]))
        && (count <= 9 || validInterest(interests[9]))
        && (count <= 10 || validInterest(interests[10]))
        && (count <= 11 || validInterest(interests[11]))
        && (count <= 12 || validInterest(interests[12]))
        && (count <= 13 || validInterest(interests[13]))
        && (count <= 14 || validInterest(interests[14]))
        && (count <= 15 || validInterest(interests[15]));
    }

    function validInterestKey(key) {
      // matches() is string-only: other Firestore types fail closed. A single
      // ASCII pattern checks type and the 72-code-unit bound within the budget.
      return key.matches('([tg]:[a-z0-9]([a-z0-9-]{0,68}[a-z0-9])?|c:[0-9a-f]{64})');
    }

    function validInterestKeys(keys) {
      let count = keys.size();
      // Candidate hints grant no access and do not prove label/key equivalence.
      return keys is list && count >= 1 && count <= 30
        && keys.toSet().size() == count
        && validInterestKey(keys[0])
        && (count <= 1 || validInterestKey(keys[1]))
        && (count <= 2 || validInterestKey(keys[2]))
        && (count <= 3 || validInterestKey(keys[3]))
        && (count <= 4 || validInterestKey(keys[4]))
        && (count <= 5 || validInterestKey(keys[5]))
        && (count <= 6 || validInterestKey(keys[6]))
        && (count <= 7 || validInterestKey(keys[7]))
        && (count <= 8 || validInterestKey(keys[8]))
        && (count <= 9 || validInterestKey(keys[9]))
        && (count <= 10 || validInterestKey(keys[10]))
        && (count <= 11 || validInterestKey(keys[11]))
        && (count <= 12 || validInterestKey(keys[12]))
        && (count <= 13 || validInterestKey(keys[13]))
        && (count <= 14 || validInterestKey(keys[14]))
        && (count <= 15 || validInterestKey(keys[15]))
        && (count <= 16 || validInterestKey(keys[16]))
        && (count <= 17 || validInterestKey(keys[17]))
        && (count <= 18 || validInterestKey(keys[18]))
        && (count <= 19 || validInterestKey(keys[19]))
        && (count <= 20 || validInterestKey(keys[20]))
        && (count <= 21 || validInterestKey(keys[21]))
        && (count <= 22 || validInterestKey(keys[22]))
        && (count <= 23 || validInterestKey(keys[23]))
        && (count <= 24 || validInterestKey(keys[24]))
        && (count <= 25 || validInterestKey(keys[25]))
        && (count <= 26 || validInterestKey(keys[26]))
        && (count <= 27 || validInterestKey(keys[27]))
        && (count <= 28 || validInterestKey(keys[28]))
        && (count <= 29 || validInterestKey(keys[29]));
    }

    function validPublicProfile(data, uid) {
      return data.keys().hasAll(['uid', 'username', 'bio', 'interests', 'discoverable', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'username', 'bio', 'interests', 'interestKeys', 'discoverable', 'updatedAt'])
        && data.uid == uid
        && data.username is string && data.username.size() >= 1 && data.username.size() <= 40
        && data.bio is string && data.bio.size() <= 240
        && validInterests(data.interests)
        && (!data.keys().hasAny(['interestKeys']) || validInterestKeys(data.interestKeys))
        && data.discoverable is bool
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function validChat(data, conversationId) {
      return data.keys().hasAll(['members', 'lastMessage', 'lastSenderId', 'updatedAt', 'lastMessageId'])
        && data.keys().hasOnly(['members', 'lastMessage', 'lastSenderId', 'updatedAt', 'lastMessageId'])
        && validMembers(data.members)
        && data.members[0] < data.members[1]
        && conversationId == conversationKey(data.members[0], data.members[1])
        && request.auth.uid in data.members
        && data.lastSenderId == request.auth.uid
        && validText(data.lastMessage)
        && data.updatedAt is timestamp && data.updatedAt == request.time
        && notBlocked(data.members[0], data.members[1])
        && validDocumentId(data.lastMessageId)
        && freshMessageForSummary(data, conversationId);
    }

    function matchingSummary(data, messageId) {
      let summary = getAfter(/databases/$(database)/documents/Chats/$(data.conversationId)).data;
      return summary.lastMessageId == messageId
        && validMembers(summary.members)
        && summary.members.toSet() == data.members.toSet()
        && summary.lastSenderId == data.senderId
        && summary.lastMessage == data.content
        && summary.updatedAt == request.time;
    }

    function validMessage(data, messageId) {
      return data.keys().hasAll(['senderId', 'receiveId', 'content', 'timestamp', 'conversationId', 'members'])
        && data.keys().hasOnly(['senderId', 'receiveId', 'content', 'timestamp', 'conversationId', 'members'])
        && data.senderId == request.auth.uid
        && validUid(data.receiveId) && data.receiveId != request.auth.uid
        && exists(/databases/$(database)/documents/PublicProfiles/$(data.receiveId))
        && validText(data.content)
        && data.timestamp is timestamp && data.timestamp == request.time
        && validMembers(data.members)
        && data.members.hasAll([data.senderId, data.receiveId])
        && data.conversationId == conversationKey(data.senderId, data.receiveId)
        && notBlocked(data.senderId, data.receiveId)
        && matchingSummary(data, messageId);
    }

    function messageParticipant() {
      return signedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.receiveId == request.auth.uid);
    }

    function chatParticipant() {
      return signedIn() && request.auth.uid in resource.data.members;
    }

    // Legacy contact fields remain in this private owner-only document.
    match /Users/{uid} {
      allow get: if owns(uid);
      allow list: if false;
      allow create, update, delete: if owns(uid);

      match /Blocked/{peerUid} {
        allow get, list: if owns(uid);
        allow create: if owns(uid) && validUid(peerUid) && peerUid != uid
          && request.resource.data.keys().hasAll(['createdAt'])
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdAt == request.time;
        allow delete: if owns(uid);
        allow update: if false;
      }
    }

    match /PublicProfiles/{uid} {
      allow get: if signedIn() && (owns(uid) || resource.data.discoverable == true);
      allow list: if signedIn() && bounded(60) && resource.data.discoverable == true;
      allow create: if owns(uid) && validPublicProfile(request.resource.data, uid);
      allow update: if owns(uid) && validPublicProfile(request.resource.data, uid)
        // Preserve opt-in schema: old replacement saves must fail atomically.
        && (!resource.data.keys().hasAny(['interestKeys'])
          || request.resource.data.keys().hasAll(['interestKeys']));
      allow delete: if false;
    }

    match /Messages/{messageId} {
      // These checks intentionally also cover the original four-field messages.
      allow get: if messageParticipant();
      allow list: if bounded(100) && messageParticipant();
      allow create: if signedIn() && validMessage(request.resource.data, messageId);
      allow update, delete: if false;
    }

    match /Chats/{conversationId} {
      allow get: if chatParticipant();
      allow list: if bounded(100) && chatParticipant();
      allow create: if signedIn() && validChat(request.resource.data, conversationId);
      allow update: if signedIn() && validChat(request.resource.data, conversationId)
        && request.resource.data.members == resource.data.members;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
